        "/v1/terminals/{terminal_id}/metrics": {
            "get": {
                "summary": "Get Terminal Metrics",
                "description": "Get time-series metrics for a terminal\n\nReturns time-series data for specified metrics within the given time range.\nAvailable metrics: latency_ms, packet_loss_pct, uptime_pct, downlink_mbps, uplink_mbps",
                "operationId": "get_terminal_metrics_v1_terminals__terminal_id__metrics_get",
                "security": [
                    {
                        "HTTPBearer": []
                    }
                ],
                "parameters": [
                    {
                        "name": "terminal_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Terminal Id"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time",
                            "description": "RFC3339 timestamp (inclusive)",
                            "title": "From"
                        },
                        "description": "RFC3339 timestamp (inclusive)"
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time",
                            "description": "RFC3339 timestamp (exclusive)",
                            "title": "To"
                        },
                        "description": "RFC3339 timestamp (exclusive)"
                    },
                    {
                        "name": "interval",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/Interval"
                                }
                            ],
                            "description": "Aggregation level",
                            "default": "5m",
                            "title": "Interval"
                        },
                        "description": "Aggregation level"
                    },
                    {
                        "name": "metrics",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Comma-separated metric keys",
                            "title": "Metrics"
                        },
                        "description": "Comma-separated metric keys"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MetricsResponse"

            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Terminal Detail"
      }
    },
    "/v1/terminals/{terminal_id}/metrics": {
      "get": {
        "description": "Get time-series metrics for a terminal\n\nReturns time-series data for specified metrics within the given time range.\nAvailable metrics: latency_ms, packet_loss_pct, uptime_pct, downlink_mbps, uplink_mbps",
        "operationId": "get_terminal_metrics_v1_terminals__terminal_id__metrics_get",
        "parameters": [
          {
            "in": "path",
            "name": "terminal_id",
            "required": true,
            "schema": {
              "title": "Terminal Id",
              "type": "string"
            }
          },
          {
            "description": "RFC3339 timestamp (inclusive)",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "RFC3339 timestamp (inclusive)",
              "format": "date-time",
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "RFC3339 timestamp (exclusive)",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "RFC3339 timestamp (exclusive)",
              "format": "date-time",
              "title": "To",
              "type": "string"
            }
          },
          {
            "description": "Aggregation level",
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Interval"
                }
              ],
              "default": "5m",
              "description": "Aggregation level",
              "title": "Interval"
            }
          },
          {
            "description": "Comma-separated metric keys",
            "in": "query",

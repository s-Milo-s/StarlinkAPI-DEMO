    "/v1/alerts": {
      "get": {
        "description": "List alerts (dashboard alerts page)\n\nReturns a filtered and paginated list of alerts for the dashboard.\nSupports filtering by status, severity, terminal, and time range.",
        "operationId": "list_alerts_v1_alerts_get",
        "parameters": [
          {
            "description": "Filter by alert status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/AlertStatus"
                }
              ],
              "default": "open",
              "description": "Filter by alert status",
              "title": "Status"
            }
          },
          {
            "description": "Filter by severity",
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AlertSeverity"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by severity",
              "title": "Severity"
            }
          },
          {
            "description": "Filter by terminal",
            "in": "query",
            "name": "terminal_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by terminal",
              "title": "Terminal Id"
            }
          },
          {
            "description": "Filter by creation time",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by creation time",
              "title": "From"
            }
          },
          {
            "description": "Filter by creation time",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by creation time",
              "title": "To"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Alerts"
      }
    },
    "/v1/fleet/health": {
      "get": {
        "description": "Fleet health summary (top-level dashboard tiles)\n\nReturns aggregate health statistics for the entire fleet including:\n- Counts of terminals by health status\n- Top issues affecting the fleet",
        "operationId": "get_fleet_health_v1_fleet_health_get",
        "parameters": [
          {
            "description": "Start time for health summary",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "Start time for health summary",
              "format": "date-time",
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "End time for health summary",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "End time for health summary",
              "format": "date-time",
              "title": "To",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FleetHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Fleet Health"
      }
    },
    "/v1/telemetry": {
      "post": {
        "description": "Ingest telemetry datapoints (idempotent)\n\nThis endpoint accepts telemetry data from terminals and returns an acceptance response.\nIn a real implementation, this would:\n- Validate the terminal_id exists\n- Store the telemetry data in a time-series database\n- Handle idempotency using the provided key",
        "operationId": "ingest_telemetry_v1_telemetry_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryIngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryIngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ingest Telemetry"
      }
    },
    "/v1/terminals": {
      "get": {
        "description": "List terminals for an account (inventory + health)\n\nReturns a paginated list of terminals with their current health status.\nUse the cursor parameter for pagination through large datasets.",
        "operationId": "list_terminals_v1_terminals_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(online|offline|degraded)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Terminals"
      }
    },
    "/v1/terminals/{terminal_id}": {
      "get": {
        "description": "Get terminal detail (health + last seen + metadata)\n\nReturns detailed information about a specific terminal including:\n- Current health status and contributing factors\n- Last seen timestamp\n- Firmware version and account information",
        "operationId": "get_terminal_detail_v1_terminals__terminal_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "terminal_id",
            "required": true,
            "schema": {
              "title": "Terminal Id",
              "type": "string"
            }
          }
        ],
        "responses": {
